{
  "name": "interview-lens",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "description": "客户需求洞察助手 - 智能客户访谈与需求洞察平台",
  "scripts": {
    "dev": "next dev --webpack",
    "dev:web": "next dev --webpack",
    "dev:api": "npm run dev --workspace @interview-lens/api",
    "dev:safe": "bash scripts/safe-dev.sh",
    "dev:3000": "bash scripts/dev-3000.sh",
    "build": "node scripts/generate-schema.js && prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint app components lib stores services types proxy.ts apps packages",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "npm run typecheck --workspace @interview-lens/api",
    "typecheck:workspaces": "npm run typecheck && npm run typecheck:api",
    "security:scan": "node scripts/security-scan.mjs",
    "ci": "npm run security:scan && npm run typecheck:workspaces && npm run test:unit && npm run build",
    "lint:json": "eslint --format json --output-file eslint-report.json",
    "lint:fix": "eslint app components lib stores services types proxy.ts apps packages --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "openapi:generate": "tsx scripts/generate-openapi-with-doc.ts",
    "openapi:check": "tsx scripts/check-openapi.ts",
    "db:generate": "node scripts/generate-schema.js && prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "generate:schema": "node scripts/generate-schema.js && prisma generate",
    "prepare": "husky",
    "test": "npm run test:e2e",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:functional": "node scripts/functional-smoke-test.js",
    "preview:local": "node scripts/local-preview.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "validate-routes": "node scripts/validate-routes.js",
    "smoke-test": "playwright test tests/smoke/",
    "qa-check": "bash scripts/qa-check.sh",
    "fix-e2e-environment": "bash scripts/fix-e2e-environment.sh"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tiptap/core": "^3.14.0",
    "@tiptap/extension-bubble-menu": "^3.14.0",
    "@tiptap/extension-character-count": "^3.14.0",
    "@tiptap/extension-collaboration": "^3.14.0",
    "@tiptap/extension-collaboration-cursor": "^3.0.0",
    "@tiptap/extension-drag-handle": "^3.14.0",
    "@tiptap/extension-emoji": "^3.14.0",
    "@tiptap/extension-link": "^3.14.0",
    "@tiptap/extension-mathematics": "^3.14.0",
    "@tiptap/extension-mention": "^3.14.0",
    "@tiptap/extension-placeholder": "^3.14.0",
    "@tiptap/extension-unique-id": "^3.14.0",
    "@tiptap/pm": "^3.14.0",
    "@tiptap/react": "^3.14.0",
    "@tiptap/starter-kit": "^3.14.0",
    "@tiptap/y-tiptap": "^3.0.1",
    "@types/qrcode": "^1.5.6",
    "@xyflow/react": "^12.10.2",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.0",
    "framer-motion": "^12.23.26",
    "jose": "^6.1.3",
    "lucide-react": "^0.561.0",
    "mongodb": "^7.1.0",
    "nanoid": "^5.1.7",
    "next": "16.4.3",
    "node-cache": "^5.1.2",
    "pptxgenjs": "^4.0.1",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-hook-form": "^7.68.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "recharts": "^3.6.0",
    "sonner": "^2.0.7",
    "swagger-ui-dist": "^5.31.0",
    "tailwind-merge": "^3.4.0",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.29",
    "zod": "^4.2.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "baseline-browser-mapping": "^2.10.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "mongodb-memory-server": "^11.3.0",
    "next-swagger-doc": "^0.4.1",
    "pdf-parse": "^2.4.5",
    "prettier": "^3.7.4",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "overrides": {
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.21"
    },
    "pptxgenjs": {
      "image-size": "2.0.4"
    }
  }
}
