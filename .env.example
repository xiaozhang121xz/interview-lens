# MongoDB数据库连接（自动同步自系统环境变量）
DATABASE_URL="mongodb://localhost:27017/your-database"

# 项目表名前缀（用于多项目数据隔离）
PROJECT_TABLE_PREFIX="talkagent"

# 产品首页名称配置（前端可访问）
NEXT_PUBLIC_PROJECT_NAME="客户需求洞察助手"

# JWT密钥配置（分别使用密码管理器生成至少32字节的随机值）
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
REFRESH_SECRET="replace-with-another-random-secret-at-least-32-characters"
VERIFICATION_CODE_SECRET="replace-with-a-third-random-secret-at-least-32-characters"

# 用户管理管理员用户名，多个用户名用逗号分隔
ADMIN_USERNAMES=""

# 可选：首次部署管理员引导。默认必须关闭。
ENABLE_DEFAULT_USER_BOOTSTRAP="false"
# DEFAULT_USER_USERNAME=""
# DEFAULT_USER_PASSWORD=""
# DEFAULT_USER_EMAIL=""

# AI 服务（OpenAI-compatible /v1/chat/completions）
AI_API_KEY="your-openai-compatible-api-key"
AI_BASE_URL="https://api.openai.com"
AI_MODEL="gpt-4o-mini"
# 继续兼容历史变量 AZSHENTONG_API_KEY / AZSHENTONG_BASE_URL / AZSHENTONG_MODEL。

# API 超时配置
# 普通 API 超时（毫秒）- 默认 20 秒
NEXT_PUBLIC_API_TIMEOUT_MS="20000"
# AI API 超时（毫秒）- 默认 5 分钟，大模型生成任务需要更长超时
NEXT_PUBLIC_AI_API_TIMEOUT_MS="300000"
# 服务端 AI 请求超时（毫秒）
AI_API_TIMEOUT_MS="120000"

# 实时转写服务配置（OpenAI-compatible WebSocket API）
# 支持第三方代理服务（如 newapi.pro）
# 获取API Key: https://platform.openai.com/api-keys 或第三方服务商
REALTIME_TRANSCRIPTION_API_KEY="your-realtime-api-key"
# WebSocket基础URL（第三方代理服务地址）
REALTIME_TRANSCRIPTION_BASE_URL="wss://api.newapi.pro/v1"
# 默认模型（gpt-4o-realtime-preview 或 gpt-4o-mini-realtime-preview）
REALTIME_TRANSCRIPTION_MODEL_DEFAULT="gpt-4o-realtime-preview"

# ============================================
# 短信服务（生产环境必填；开发环境未配置时使用控制台 Mock）
# Webhook 接收 JSON：{ type, phone, code?, content?, expiresInSeconds? }
# ============================================
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# 飞书文档读取（仅服务端，配置后请将调用账号加入 ADMIN_USERNAMES）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ============================================
# Tiptap Access Control（ES256，服务端私钥不得使用 NEXT_PUBLIC_ 前缀）
# ============================================
TIPTAP_ENVIRONMENT_ID=
TIPTAP_PRIVATE_KEY=
NEXT_PUBLIC_TIPTAP_COLLAB_APP_ID=

# ============================================
# 企查查API配置（企业信息查询）
# ============================================
# 获取方式：企查查开放平台 https://openapi.qcc.com
# 接口费用：企业基础信息 0.01-0.05元/次

# 企查查AppKey
QICHACHA_APP_KEY="your-qichacha-app-key"

# 企查查SecretKey（用于签名）
QICHACHA_SECRET_KEY="your-qichacha-secret-key"

# 企查查API基础URL（可选，默认官方地址）
QICHACHA_BASE_URL="https://api.qichacha.com"

# 是否启用企查查API（默认启用）
ENABLE_QICHACHA_API="true"

# 企查查缓存过期时间（秒，默认24小时）
QICHACHA_CACHE_TTL="86400"

# ============================================
# 数据源优先级配置
# ============================================
# 是否同时启用天眼查爬虫作为备用（默认关闭）
ENABLE_TIANYANCHA_CRAWLER="false"

# 数据源模式：'qichacha-only' 或 'multi-source'
DATA_SOURCE_MODE="qichacha-only"
